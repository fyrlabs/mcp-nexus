{
  "name": "@fyrlabs/mcp-nexus",
  "version": "0.0.1",
  "description": "Local-first intelligent MCP router: one endpoint, many MCP servers, capabilities discovered on demand.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "mcp-nexus": "./dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "router",
    "gateway",
    "ai",
    "agent",
    "llm",
    "tool-discovery",
    "context-window",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fyrlabs/mcp-nexus.git"
  },
  "bugs": {
    "url": "https://github.com/fyrlabs/mcp-nexus/issues"
  },
  "homepage": "https://github.com/fyrlabs/mcp-nexus#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@modelcontextprotocol/server-everything": "^2026.8.18",
    "@types/node": "^26.0.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
